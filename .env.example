# Site
NEXT_PUBLIC_SITE_URL=https://bestiphonecamerasettings.com
NEXT_PUBLIC_SITE_NAME=Best iPhone Camera Settings

# Analytics (vendor-neutral; leave empty to disable)
NEXT_PUBLIC_ANALYTICS_PROVIDER=
NEXT_PUBLIC_ANALYTICS_WRITE_KEY=

# Newsletter adapter (mock | buttlond | convertkit | custom)
NEWSLETTER_PROVIDER=mock
NEWSLETTER_API_URL=
NEWSLETTER_API_KEY=
NEWSLETTER_LIST_ID=

# Affiliate / ads
NEXT_PUBLIC_AFFILIATE_NETWORK=
NEXT_PUBLIC_AFFILIATE_TAG=
NEXT_PUBLIC_ADS_ENABLED=false
NEXT_PUBLIC_ADS_CLIENT_ID=

# Region defaults for affiliate links
NEXT_PUBLIC_DEFAULT_REGION=US

# Feature flags
NEXT_PUBLIC_PREMIUM_CTA_ENABLED=true
NEXT_PUBLIC_NEWSLETTER_ENABLED=true
